---
// 💡 아스트로 진짜 글 수집 엔진 가동! 
import { getCollection } from 'astro:content';
const allPosts = await getCollection('blog');

// 💡 내가 지정한 순서(sortOrder) 번호대로 정렬, 번호가 없으면 날짜순 정렬
const sortedPosts = allPosts.sort((a, b) => {
  const orderA = a.data.sortOrder ?? 999;
  const orderB = b.data.sortOrder ?? 999;
  if (orderA !== orderB) return orderA - orderB;
  return b.data.pubDate.valueOf() - a.data.pubDate.valueOf();
});
---
<!DOCTYPE html>
<html lang="ko">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>JM 홈페이지</title>
  
  <style>
 /* [🎨 연보라 & 라벤더 감성 베이스 디자인] */
* { box-sizing: border-box; margin: 0; padding: 0; }
body { 
  font-family: "Apple SD Gothic Neo", "Malgun Gothic", -apple-system, sans-serif;
  background-color: #F8F6FA; 
  color: #332E3A; 
}

/* 배너 크기 슬림화 조정 */
.banner-container { width: 100%; margin: 20px auto 0 auto; padding: 0 15px; }
.main-banner { width: 100%; height: 110px; border-radius: 16px; object-fit: cover; box-shadow: 0 4px 20px rgba(163, 132, 219, 0.08); }

/* 카테고리 탭 디자인 */
.category-section { margin: 25px auto 5px auto; padding: 0 15px; }
.category-tabs { display: flex; gap: 10px; flex-wrap: wrap; }
.tab-btn { padding: 8px 16px; background: white; border: 1px solid #E4DFEB; border-radius: 20px; cursor: pointer; font-size: 13px; font-weight: bold; color: #6E6578; transition: all 0.25s ease; }
.tab-btn:hover, .tab-btn.active { background: #A384DB; color: white; border-color: #A384DB; box-shadow: 0 4px 10px rgba(163, 132, 219, 0.2); }

/* 본문 카드 그리드 */
.main-content { padding: 15px; display: flex; flex-direction: column; gap: 15px; margin: 0 auto; }
.card { background: white; padding: 25px; border-radius: 20px; box-shadow: 0 4px 15px rgba(163, 132, 219, 0.04); border: 1px solid #F1EDF5; width: 100%; transition: transform 0.2s; }
.card:hover { transform: translateY(-3px); }
.card-link { text-decoration: none; display: block; color: inherit; }

.card h2 { font-size: 19px; font-weight: 800; margin-bottom: 8px; color: #4A3E56; letter-spacing: -0.3px; }
.card p { font-size: 14px; color: #6E6578; line-height: 1.6; margin-bottom: 12px; }
.post-date { font-size: 12px; color: #A384DB; font-weight: bold; }

/* 📐 반응형 그리드 핏 조율 */
@media (min-width: 640px) { .main-banner { height: 140px; } }
@media (min-width: 768px) {
  body { background-color: #EFE9F3; }
  .main-banner { height: 170px; }
  .main-content { flex-direction: row; flex-wrap: wrap; padding: 20px; gap: 20px; }
  .card { width: 48%; }
}
@media (min-width: 1280px) {
  body { background-color: #F8F6FA; }
  .main-banner { height: 220px; }
  .banner-container, .category-section, .main-content { max-width: 1200px; padding-left: 0; padding-right: 0; }
}

/* 💬 챗봇 디자인 */
.chat-badge { position: fixed; bottom: 30px; right: 30px; width: 60px; height: 60px; background: #A384DB; border-radius: 50%; color: white; display: flex; align-items: center; justify-content: center; font-size: 24px; cursor: pointer; box-shadow: 0 8px 25px rgba(163, 132, 219, 0.35); z-index: 1000; }
.chat-box { position: fixed; bottom: 105px; right: 30px; width: 340px; height: 0; background: #F1EDF5; border-radius: 20px; box-shadow: 0 10px 35px rgba(163, 132, 219, 0.15); display: flex; flex-direction: column; overflow: hidden; z-index: 1000; border: 1px solid #E4DFEB; transition: height 0.3s ease; }
.chat-box.open { height: 480px; }
.chat-header { background: #9172C9; color: white; padding: 18px; font-weight: bold; font-size: 15px; }
.chat-messages { flex: 1; padding: 15px; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; background-color: #FDFBFF; }
.chat-input-area { display: flex; background: white; padding: 12px; border-top: 1px solid #F1EDF5; }
.chat-input-area input { flex: 1; padding: 10px 16px; border: 1px solid #E4DFEB; border-radius: 20px; outline: none; background: #F8F6FA; }
.chat-input-area button { margin-left: 8px; padding: 10px 18px; background: #A384DB; color: white; border: none; border-radius: 20px; cursor: pointer; font-weight: bold; }
  </style>
</head>
<body>

<div class="banner-container">
  <!-- 💡 바탕화면 public/images/banner.png 사진이 여기에 뜹니다 -->
  <img src="/images/banner.png" alt="메인 배너" class="main-banner" onerror="this.src='https://unsplash.com'">
</div>

<div class="category-section">
  <div class="category-tabs">
    <button class="tab-btn active" onclick="changeCategory('all', this)">전체보기</button>
    <button class="tab-btn" onclick="changeCategory('price', this)">상담안내</button>
    <button class="tab-btn" onclick="changeCategory('location', this)">영상</button>
  </div>
</div>

<div class="main-content" id="content-area">
  <!-- 💡 가짜 카드를 싹 지우고, 깃허브에 들어있는 진짜 글 데이터만 루프를 돌며 카드로 뽑아냅니다 -->
  {sortedPosts.map((post) => (
    <div class="card" data-category={post.data.tags ? post.data.tags[0] : 'all'}>
      <a href={`/jm-astro-blog/blog/${post.slug}/`} class="card-link">
        <h2>{post.data.title}</h2>
        <p>{post.data.description}</p>
        <span class="post-date">📅 {post.data.pubDate.toLocaleDateString('ko-KR', { year: 'numeric', month: 'long', day: 'numeric' })}</span>
      </a>
    </div>
  ))}
</div>

<div class="chat-badge" id="badge-btn">💬</div>
<div class="chat-box" id="box-window">
  <div class="chat-header">💜 라벤더 상담소</div>
  <div class="chat-messages" id="msg-container">
    <div class="bubble" style="background: #F1EDF5; padding: 11px 15px; border-radius: 16px; font-size: 13.5px;">안녕하세요! 궁금한 점이 있으시다면 편하게 질문해 주세요. ✨</div>
  </div>
  <div class="chat-input-area"><input type="text" placeholder="질문을 입력하세요..."><button>전송</button></div>
</div>

<script is:inline>
  const badgeBtn = document.getElementById('badge-btn');
  const boxWindow = document.getElementById('box-window');
  badgeBtn.addEventListener('click', () => { boxWindow.classList.toggle('open'); });

  function changeCategory(type, element) {
    document.querySelectorAll('.tab-btn').forEach(btn => btn.classList.remove('active'));
    if (element) element.classList.add('active');
    
    document.querySelectorAll('.card').forEach(card => {
      const cardCat = card.getAttribute('data-category');
      if (type === 'all' || cardCat === type) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }
</script>
</body>
</html>
